<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Permitir backup de preferencias del usuario -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="user_preferences.db" />
        
        <!-- Excluir información sensible -->
        <exclude domain="root" path="device_info/" />
        <exclude domain="database" path="sensitive_data.db" />
    </cloud-backup>
    
    <device-transfer>
        <!-- Permitir transferencia de datos entre dispositivos -->
        <include domain="sharedpref" path="." />
        <include domain="database" path="user_data.db" />
    </device-transfer>
</data-extraction-rules>